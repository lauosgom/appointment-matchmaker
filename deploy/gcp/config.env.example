# Copy to config.env (not committed) and fill in. Read by deploy.sh.

# Your existing Google Cloud project.
PROJECT_ID=
# us-east1 (South Carolina) is close to Neon's AWS us-east-1 (N. Virginia)
# and is in Cloud Run's lowest price tier.
REGION=us-east1
# Prefix of everything the script creates in the project.
SERVICE=appointment-matchmaker

# Address users open the app at; links in emails point here.
# Leave empty to use the Cloud Run URL (https://SERVICE-….run.app).
APP_BASE_URL=

# Brevo SMTP (Brevo → SMTP & API → SMTP). The SMTP key itself is asked for by
# deploy.sh and kept in Secret Manager, never in this file.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
# A sender verified in Brevo (Senders, domains & dedicated IPs → Senders).
MAIL_FROM="Citas con especialistas <citas@example.org>"
